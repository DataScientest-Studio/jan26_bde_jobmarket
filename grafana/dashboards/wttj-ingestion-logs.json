          "rawSql": "SELECT \n  timestamp,\n  level,\n  message,\n  task_id,\n  duration_sec,\n  records_count,\n  error_count,\n  extra_metadata\nFROM ingestion_logs\nWHERE \n  endpoint = 'welcome_to_the_jungle'\n  AND $__timeFilter(timestamp)\nORDER BY timestamp DESC\nLIMIT 100",
