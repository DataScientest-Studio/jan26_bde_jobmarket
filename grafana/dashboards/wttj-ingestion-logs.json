          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(timestamp, '5m') as time,\n  COUNT(*) as \"Operations\"\nFROM ingestion_logs\nWHERE \n  endpoint = 'welcome_to_the_jungle'\n  AND $__timeFilter(timestamp)\nGROUP BY time\nORDER BY time",
