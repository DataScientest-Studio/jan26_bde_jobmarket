          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(timestamp, '5m') as time,\n  COUNT(*) as \"Errors\"\nFROM ingestion_logs\nWHERE \n  endpoint = 'welcome_to_the_jungle'\n  AND level IN ('ERROR', 'WARNING')\n  AND $__timeFilter(timestamp)\nGROUP BY time\nORDER BY time",
