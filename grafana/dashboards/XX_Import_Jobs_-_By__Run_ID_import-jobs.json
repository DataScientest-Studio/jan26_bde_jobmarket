        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  started_at,\n  run_id,\n  source,\n  status,\n  progress_pct,\n  case when duration_ms is null then null else to_char(to_timestamp(duration_ms / 1000.0), 'HH24:MI:SS') end as duration,\n  records_count,\n  records_per_sec,\n  pages_count,\n  errors_count,\n  message\nfrom job_runs\norder by started_at desc\nlimit 100;",
          "refId": "A"
