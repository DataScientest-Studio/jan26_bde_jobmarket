    { "id": 16, "type": "timeseries", "title": "Distribution des statuts d'offres (published / unpublished / reappeared)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "FT — published" },   "properties": [{ "id": "color", "value": { "fixedColor": "green",      "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "FT — unpublished" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange",     "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "FT — reappeared" },  "properties": [{ "id": "color", "value": { "fixedColor": "blue",        "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "WTTJ — published" }, "properties": [{ "id": "color", "value": { "fixedColor": "dark-green",  "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "WTTJ — unpublished" },"properties": [{ "id": "color", "value": { "fixedColor": "red",        "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "WTTJ — reappeared" },"properties": [{ "id": "color", "value": { "fixedColor": "dark-blue",  "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pipeline_status_count{stage=\"silver\",offer_source=\"FT\",status=\"published\"}",    "legendFormat": "FT — published" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pipeline_status_count{stage=\"silver\",offer_source=\"FT\",status=\"unpublished\"}",  "legendFormat": "FT — unpublished" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pipeline_status_count{stage=\"silver\",offer_source=\"FT\",status=\"reappeared\"}",   "legendFormat": "FT — reappeared" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pipeline_status_count{stage=\"silver\",offer_source=\"WTTJ\",status=\"published\"}",  "legendFormat": "WTTJ — published" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pipeline_status_count{stage=\"silver\",offer_source=\"WTTJ\",status=\"unpublished\"}","legendFormat": "WTTJ — unpublished" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pipeline_status_count{stage=\"silver\",offer_source=\"WTTJ\",status=\"reappeared\"}",  "legendFormat": "WTTJ — reappeared" }
      ]
