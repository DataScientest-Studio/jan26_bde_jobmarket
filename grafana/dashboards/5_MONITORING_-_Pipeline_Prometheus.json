{
  "uid": "jobmarket-pipeline-prometheus",
  "title": "5 — Pipeline Monitoring (Prometheus)",
  "description": "Statut des runs par couche médaillon — Bronze / Silver / Gold",
  "tags": ["prometheus", "pipeline", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [

    { "id": 1, "type": "text", "title": "", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 2 },
      "options": { "mode": "markdown", "content": "## 🥉 Bronze — Ingestion" } },

    { "id": 2, "type": "stat", "title": "Ingest FT",
      "gridPos": { "x": 0, "y": 2, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "vertical" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "1": { "text": "OK", "color": "green" }, "0": { "text": "FAIL", "color": "red" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": [{ "matcher": { "id": "byName", "options": "Dernier run" }, "properties": [
          { "id": "unit", "value": "dateTimeAsLocal" },
          { "id": "mappings", "value": [] },
          { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
          { "id": "decimals", "value": 0 }
        ]}]
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pipeline_run_status{stage=\"bronze\",source=\"france_travail\"}", "legendFormat": "France Travail", "instant": true },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "pipeline_last_run_unixtime{stage=\"bronze\",source=\"france_travail\"}", "legendFormat": "Dernier run", "instant": true }
      ]
    },

