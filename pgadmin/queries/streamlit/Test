	COUNT(*) AS nb
FROM gold.fact_offre_emploi f
JOIN gold.dim_type_contrat c ON c.contract_key = f.contract_key
WHERE c.contract_type != 'UNKNOWN'
GROUP BY c.contract_type
ORDER BY nb DESC
LIMIT 10;


