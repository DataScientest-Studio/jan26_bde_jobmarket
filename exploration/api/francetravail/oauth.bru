meta {
  name: OAuth
  type: http
  seq: 1
}

post {
  url: https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire&grant_type=client_credentials&client_id={{API_ID}}&client_secret={{API_SECRET}}&scope=api_offresdemploiv2 o2dsoffre nomenclatureRome api_rome-metiersv1 api_rome-competencesv1
  body: none
  auth: none
}

params:query {
  realm: /partenaire
  grant_type: client_credentials
  client_id: {{API_ID}}
  client_secret: {{API_SECRET}}
  scope: api_offresdemploiv2 o2dsoffre nomenclatureRome api_rome-metiersv1 api_rome-competencesv1
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

docs {
  https://francetravail.io/produits-partages/documentation/utilisation-api-france-travail/client-credentials
}
